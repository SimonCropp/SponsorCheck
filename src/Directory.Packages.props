    <PackageVersion Include="Polyfill" Version="10.3.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="TUnit" Version="1.43.11" />
    <PackageVersion Include="Verify" Version="31.16.2" />
    <PackageVersion Include="Verify.TUnit" Version="31.16.2" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.1.2" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.2.0" />
  </ItemGroup>
</Project>