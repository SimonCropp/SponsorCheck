    <PackageVersion Include="RemoteZip" Version="0.2.1" />
    <PackageVersion Include="System.Text.Json" Version="10.0.10" />
    <PackageVersion Include="Polyfill" Version="11.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="TUnit" Version="1.63.0" />
    <PackageVersion Include="Verify" Version="31.28.0" />
    <PackageVersion Include="Verify.TUnit" Version="31.28.0" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.4.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="Verify.Bunit" Version="14.0.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="Verify.Playwright" Version="3.1.1" />
  </ItemGroup>
</Project>