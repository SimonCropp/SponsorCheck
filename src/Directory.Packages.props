    <PackageVersion Include="Polyfill" Version="10.7.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="TUnit" Version="1.48.0" />
    <PackageVersion Include="Verify" Version="31.18.0" />
    <PackageVersion Include="Verify.TUnit" Version="31.18.0" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.2.0" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.3.0" />
  </ItemGroup>
</Project>