<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
    <!-- signatureValidationMode=require rejects any package whose signature has no matching entry
         here. SponsorCheck.Web needs Microsoft.NET.Sdk.WebAssembly.Pack, which the .NET SDK serves
         from its own C:\Program Files\dotnet\library-packs folder; packs from there are AUTHOR
         signed by Microsoft rather than REPOSITORY signed by nuget.org, so the entry above cannot
         cover them and restore fails with NU3034.
         This certificate expires 2026-10-18. When Microsoft re-signs with a new one, refresh by
         running "dotnet nuget trust author microsoft <path-to-pack>.nupkg" with the configfile
         option pointed at this file, so the fingerprint is read from the package rather than
         copied by hand. -->
    <author name="microsoft">
      <certificate fingerprint="566A31882BE208BE4422F7CFD66ED09F5D4524A5994F50CCC8B05EC0528C1353" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
  </trustedSigners>
</configuration>
