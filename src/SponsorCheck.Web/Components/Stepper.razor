<ol class="stepper">
    @for (var i = 0; i < Labels.Count; i++)
    {
        var index = i;
        @if (index < Active)
        {
            <li class="done">
                <button type="button" class="step-link" title="Back to step @(index + 1): @Labels[index]"
                        @onclick="() => StepSelected.InvokeAsync(index)"><span class="step-num">@(index + 1).</span> @Labels[index]</button>
            </li>
        }
        else
        {
            <li class="@(index == Active ? "active" : "")"><span class="step-num">@(index + 1).</span> @Labels[index]</li>
        }
    }
</ol>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Labels { get; set; } = [];
    [Parameter] public int Active { get; set; }

    /// <summary>Raised with the index of a completed step when it is clicked — steps ahead of the
    /// active one are not clickable, since they are gated by validation.</summary>
    [Parameter] public EventCallback<int> StepSelected { get; set; }
}
