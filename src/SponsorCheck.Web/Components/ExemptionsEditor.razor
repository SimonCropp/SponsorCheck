<div class="exemptions-editor">
    @foreach (var entry in Model.Exemptions)
    {
        var current = entry;
        <div class="exemption-row">
            <input type="text"
                   class="exemption-name"
                   placeholder="Name (e.g. Consulting)"
                   @bind="current.Name"
                   @bind:event="oninput"
                   @bind:after="NotifyChanged" />
            <input type="text"
                   class="exemption-message"
                   placeholder="Criteria text shown in the consumer's build warning"
                   @bind="current.Message"
                   @bind:event="oninput"
                   @bind:after="NotifyChanged" />
            <input type="text"
                   class="exemption-max-term"
                   placeholder="Max months"
                   @bind="current.MaxTermMonths"
                   @bind:event="oninput"
                   @bind:after="NotifyChanged" />
            <button type="button"
                    @onclick="() => Remove(current)">Remove</button>
        </div>
    }

    <button type="button"
            class="add-exemption"
            @onclick="Add">Add exemption</button>

    <p class="exemptions-hint">
        Leave max months blank for an open-ended exemption. Set it and the consumer must also declare
        <code>SponsorshipExemptionUntil</code>, dated no further out than that — so a claim they stop
        qualifying for fails the build instead of riding along unnoticed.
    </p>

    @foreach (var error in Model.ExemptionErrors)
    {
        <p class="validation-error">@error</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public AuthorModel Model { get; set; } = new();
    [Parameter] public EventCallback Changed { get; set; }

    Task NotifyChanged() => Changed.InvokeAsync();

    Task Add()
    {
        Model.Exemptions.Add(new());
        return NotifyChanged();
    }

    Task Remove(ExemptionEntry entry)
    {
        Model.Exemptions.Remove(entry);
        return NotifyChanged();
    }
}
