@inherits LayoutComponentBase

<header class="app-header">
    <div class="inner">
        <h1><a href="">SponsorCheck Setup Wizard</a></h1>
        <p>
            Guided configuration for
            <a href="https://github.com/SimonCropp/SponsorCheck" target="_blank">SponsorCheck</a>
            — build-time sponsorship verification for NuGet packages.
        </p>
    </div>
</header>

<main>
    @Body
</main>

<footer class="app-footer">
    SponsorCheck adds no runtime dependency — verification happens only during the build.
    Full documentation in the
    <a href="https://github.com/SimonCropp/SponsorCheck#readme" target="_blank">readme</a>,
    the <a href="https://github.com/SimonCropp/SponsorCheck/blob/main/docs/ConsumerUsage.md" target="_blank">consumer guide</a>,
    and the <a href="https://github.com/SimonCropp/SponsorCheck/blob/main/docs/AuthorSetup.md" target="_blank">author guide</a>.
</footer>
