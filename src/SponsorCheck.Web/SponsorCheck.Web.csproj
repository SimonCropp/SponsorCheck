<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>

  <!-- The wizard's default SponsorCheck version tracks $(Version) from src/Directory.Build.props. -->
  <Target Name="GenerateWizardDefaults" BeforeTargets="CoreCompile">
    <ItemGroup>
      <WizardDefaultsLine Include="// Generated by GenerateWizardDefaults in SponsorCheck.Web.csproj." />
      <WizardDefaultsLine Include="namespace SponsorCheck.Web%3B" />
      <WizardDefaultsLine Include="public static class WizardDefaults" />
      <WizardDefaultsLine Include="{" />
      <WizardDefaultsLine Include="    public const string SponsorCheckVersion = &quot;$(Version)&quot;%3B" />
      <WizardDefaultsLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)WizardDefaults.g.cs"
      Lines="@(WizardDefaultsLine)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WizardDefaults.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)WizardDefaults.g.cs" />
    </ItemGroup>
  </Target>

</Project>
