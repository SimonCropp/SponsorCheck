<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472</TargetFrameworks>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PackageTags>sponsors;sponsorship;build;msbuild;github;opencollective;polar;opensource;maintenance;fee</PackageTags>
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <UserSecretsId>0b81e813-4e7d-40f9-810b-9bd2cddd69e4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="Runtime" />
    <PackageReference Include="Microsoft.Build.Framework"      PrivateAssets="all" ExcludeAssets="Runtime" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\SponsorCheck.targets" Pack="true" PackagePath="build\SponsorCheck.targets;buildMultiTargeting\SponsorCheck.targets" />
    <None Include="EmbeddedTemplates\ConsumerVerifier.targets" Pack="true" PackagePath="build\ConsumerVerifier.targets;buildMultiTargeting\ConsumerVerifier.targets" Visible="false" />
    <None Include="EmbeddedTemplates\ConsumerVerifierOwner.targets" Pack="true" PackagePath="build\ConsumerVerifierOwner.targets;buildMultiTargeting\ConsumerVerifierOwner.targets" Visible="false" />
    <None Include="nuget-readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Emits the version-scoped task type the shipped verifier binds to. MSBuild's task registry is
       keyed by task name — not by assembly identity, path, or version — and the first UsingTask to
       claim a name serves every invocation of it in that project. So when two packages each bundle
       their own SponsorCheck copy under the bare name VerifySponsorshipTask, one copy runs both
       verifiers, and the build dies with MSB4064 as soon as the newer verifier passes a parameter
       the older task lacks. Suffixing the type with the SponsorCheck version gives each release its
       own registry slot, so skewed packages coexist. VersionedTaskName.Verify keeps the bundler's
       __SC_TASK_NAME__ substitution in lockstep with the type actually compiled here.

       Sanitizing '.'/'-'/'+' keeps prerelease and metadata versions ('0.19.0-beta.1') valid as both
       a C# identifier and an MSBuild task name. The '.g.cs' suffix marks the file generated, which
       is what keeps EnforceCodeStyleInBuild from failing it on the underscored type name. -->
  <Target Name="_SponsorCheck_GenerateVersionedTaskName" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <_SponsorCheck_VerifyTaskName>VerifySponsorshipTask_$(Version.Replace('.', '_').Replace('-', '_').Replace('+', '_'))</_SponsorCheck_VerifyTaskName>
      <_SponsorCheck_VersionedTaskNameFile>$(IntermediateOutputPath)VersionedTaskName.g.cs</_SponsorCheck_VersionedTaskNameFile>
    </PropertyGroup>
    <ItemGroup>
      <_SponsorCheck_VersionedTaskNameLine Include="// &lt;auto-generated /&gt;" />
      <_SponsorCheck_VersionedTaskNameLine Include="public sealed class $(_SponsorCheck_VerifyTaskName) : VerifySponsorshipTask" />
      <_SponsorCheck_VersionedTaskNameLine Include="{" />
      <_SponsorCheck_VersionedTaskNameLine Include="}" />
      <_SponsorCheck_VersionedTaskNameLine Include="public static class VersionedTaskName" />
      <_SponsorCheck_VersionedTaskNameLine Include="{" />
      <_SponsorCheck_VersionedTaskNameLine Include="    public const string Verify = nameof($(_SponsorCheck_VerifyTaskName))%3B" />
      <_SponsorCheck_VersionedTaskNameLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_SponsorCheck_VersionedTaskNameFile)"
                      Lines="@(_SponsorCheck_VersionedTaskNameLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_SponsorCheck_VersionedTaskNameFile)" />
      <FileWrites Include="$(_SponsorCheck_VersionedTaskNameFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_SponsorCheck_PackTaskDlls" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <!-- Forward slash, not backslash, in PackagePath: MSBuild on Linux normalizes the trailing '\'
           to '/', then NuGet pack's file-append logic adds another '/' before the filename, producing
           'tasks/netstandard2.0//SponsorCheck.dll' (double slash) in the nupkg. Forward slash sidesteps
           the normalization step entirely and yields the same single-slash path on both platforms. -->
      <None Include="bin\$(Configuration)\netstandard2.0\*.dll" Pack="true" PackagePath="tasks/netstandard2.0/" Visible="false" />
      <None Include="bin\$(Configuration)\net472\*.dll" Pack="true" PackagePath="tasks/net472/" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
