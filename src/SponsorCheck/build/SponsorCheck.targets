<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <_SponsorCheck_TasksDir>$(MSBuildThisFileDirectory)..\tasks\</_SponsorCheck_TasksDir>
    <_SponsorCheck_TasksAssembly Condition="'$(MSBuildRuntimeType)' == 'Core'">$(_SponsorCheck_TasksDir)netstandard2.0\SponsorCheck.dll</_SponsorCheck_TasksAssembly>
    <_SponsorCheck_TasksAssembly Condition="'$(MSBuildRuntimeType)' != 'Core'">$(_SponsorCheck_TasksDir)net472\SponsorCheck.dll</_SponsorCheck_TasksAssembly>
    <_SponsorCheck_VerifierTemplate>$(MSBuildThisFileDirectory)ConsumerVerifier.targets</_SponsorCheck_VerifierTemplate>
    <_SponsorCheck_VerifierOwnerTemplate>$(MSBuildThisFileDirectory)ConsumerVerifierOwner.targets</_SponsorCheck_VerifierOwnerTemplate>
  </PropertyGroup>

  <UsingTask TaskName="BundleSponsorListTask"
             AssemblyFile="$(_SponsorCheck_TasksAssembly)" />

  <Target Name="_SponsorCheck_BundleSponsorList"
          BeforeTargets="_GetPackageFiles;GenerateNuspec"
          Condition="'$(Configuration)' == 'Release' and '$(IsPackable)' == 'true'">
    <PropertyGroup>
      <_SponsorCheck_HashListPath>$(IntermediateOutputPath)SponsorCheck\SponsorHashes.txt</_SponsorCheck_HashListPath>
      <_SponsorCheck_GeneratedTargetsPath>$(IntermediateOutputPath)SponsorCheck\$(PackageId).targets</_SponsorCheck_GeneratedTargetsPath>
      <_SponsorCheck_PackDatePath>$(IntermediateOutputPath)SponsorCheck\PackDate.txt</_SponsorCheck_PackDatePath>
      <_SponsorCheck_AuthorAccountsPath>$(IntermediateOutputPath)SponsorCheck\AuthorAccounts.txt</_SponsorCheck_AuthorAccountsPath>
      <_SponsorCheck_SeverityOverridesPath>$(IntermediateOutputPath)SponsorCheck\SeverityOverrides.txt</_SponsorCheck_SeverityOverridesPath>
      <_SponsorCheck_MessageOverridesPath>$(IntermediateOutputPath)SponsorCheck\MessageOverrides.json</_SponsorCheck_MessageOverridesPath>
      <_SponsorCheck_LandingUrlPath>$(IntermediateOutputPath)SponsorCheck\LandingUrl.txt</_SponsorCheck_LandingUrlPath>
    </PropertyGroup>

    <ItemGroup>
      <_SponsorCheck_Self    Include="@(PackageReference)" Condition="'%(Identity)' == 'SponsorCheck'" />
      <_SponsorCheck_SelfVer Include="@(PackageVersion)"   Condition="'%(Identity)' == 'SponsorCheck'" />
    </ItemGroup>

    <!-- Flatten item-metadata into scalar properties. Using %(ItemGroup.Metadata) directly as
         task parameters causes MSBuild to batch the task per unique item identity — and with two
         ItemGroups in scope (PackageReference + PackageVersion under CPM) the task gets invoked
         once per batch. The PackageReference batch typically has no SponsorCheck metadata under
         CPM (it lives on PackageVersion), so that batch trips SC101 even though the other one
         succeeds. Item transforms below produce a single string, which kills the batching. -->
    <PropertyGroup>
      <_SponsorCheck_GitHubFromRef>@(_SponsorCheck_Self->'%(GitHubSponsorsAccount)')</_SponsorCheck_GitHubFromRef>
      <_SponsorCheck_GitHubFromVer>@(_SponsorCheck_SelfVer->'%(GitHubSponsorsAccount)')</_SponsorCheck_GitHubFromVer>
      <_SponsorCheck_OpenCollectiveFromRef>@(_SponsorCheck_Self->'%(OpenCollectiveAccount)')</_SponsorCheck_OpenCollectiveFromRef>
      <_SponsorCheck_OpenCollectiveFromVer>@(_SponsorCheck_SelfVer->'%(OpenCollectiveAccount)')</_SponsorCheck_OpenCollectiveFromVer>
      <_SponsorCheck_PolarFromRef>@(_SponsorCheck_Self->'%(PolarAccount)')</_SponsorCheck_PolarFromRef>
      <_SponsorCheck_PolarFromVer>@(_SponsorCheck_SelfVer->'%(PolarAccount)')</_SponsorCheck_PolarFromVer>
      <_SponsorCheck_OwnerFromRef>@(_SponsorCheck_Self->'%(SponsorOwner)')</_SponsorCheck_OwnerFromRef>
      <_SponsorCheck_OwnerFromVer>@(_SponsorCheck_SelfVer->'%(SponsorOwner)')</_SponsorCheck_OwnerFromVer>
      <_SponsorCheck_NoLicenseSpecifiedSevFromRef>@(_SponsorCheck_Self->'%(NoLicenseSpecifiedSeverityOverride)')</_SponsorCheck_NoLicenseSpecifiedSevFromRef>
      <_SponsorCheck_NoLicenseSpecifiedSevFromVer>@(_SponsorCheck_SelfVer->'%(NoLicenseSpecifiedSeverityOverride)')</_SponsorCheck_NoLicenseSpecifiedSevFromVer>
      <_SponsorCheck_LicenseIgnoredSevFromRef>@(_SponsorCheck_Self->'%(LicenseIgnoredSeverityOverride)')</_SponsorCheck_LicenseIgnoredSevFromRef>
      <_SponsorCheck_LicenseIgnoredSevFromVer>@(_SponsorCheck_SelfVer->'%(LicenseIgnoredSeverityOverride)')</_SponsorCheck_LicenseIgnoredSevFromVer>
      <_SponsorCheck_InvalidAccountSevFromRef>@(_SponsorCheck_Self->'%(InvalidAccountSeverityOverride)')</_SponsorCheck_InvalidAccountSevFromRef>
      <_SponsorCheck_InvalidAccountSevFromVer>@(_SponsorCheck_SelfVer->'%(InvalidAccountSeverityOverride)')</_SponsorCheck_InvalidAccountSevFromVer>
      <_SponsorCheck_LicenseExpiredSevFromRef>@(_SponsorCheck_Self->'%(LicenseExpiredSeverityOverride)')</_SponsorCheck_LicenseExpiredSevFromRef>
      <_SponsorCheck_LicenseExpiredSevFromVer>@(_SponsorCheck_SelfVer->'%(LicenseExpiredSeverityOverride)')</_SponsorCheck_LicenseExpiredSevFromVer>
      <_SponsorCheck_NoLicenseSpecifiedMsgFromRef>@(_SponsorCheck_Self->'%(NoLicenseSpecifiedMessageOverride)')</_SponsorCheck_NoLicenseSpecifiedMsgFromRef>
      <_SponsorCheck_NoLicenseSpecifiedMsgFromVer>@(_SponsorCheck_SelfVer->'%(NoLicenseSpecifiedMessageOverride)')</_SponsorCheck_NoLicenseSpecifiedMsgFromVer>
      <_SponsorCheck_LicenseIgnoredMsgFromRef>@(_SponsorCheck_Self->'%(LicenseIgnoredMessageOverride)')</_SponsorCheck_LicenseIgnoredMsgFromRef>
      <_SponsorCheck_LicenseIgnoredMsgFromVer>@(_SponsorCheck_SelfVer->'%(LicenseIgnoredMessageOverride)')</_SponsorCheck_LicenseIgnoredMsgFromVer>
      <_SponsorCheck_InvalidAccountMsgFromRef>@(_SponsorCheck_Self->'%(InvalidAccountMessageOverride)')</_SponsorCheck_InvalidAccountMsgFromRef>
      <_SponsorCheck_InvalidAccountMsgFromVer>@(_SponsorCheck_SelfVer->'%(InvalidAccountMessageOverride)')</_SponsorCheck_InvalidAccountMsgFromVer>
      <_SponsorCheck_LicenseExpiredMsgFromRef>@(_SponsorCheck_Self->'%(LicenseExpiredMessageOverride)')</_SponsorCheck_LicenseExpiredMsgFromRef>
      <_SponsorCheck_LicenseExpiredMsgFromVer>@(_SponsorCheck_SelfVer->'%(LicenseExpiredMessageOverride)')</_SponsorCheck_LicenseExpiredMsgFromVer>
      <_SponsorCheck_LandingUrlFromRef>@(_SponsorCheck_Self->'%(SponsorLandingUrl)')</_SponsorCheck_LandingUrlFromRef>
      <_SponsorCheck_LandingUrlFromVer>@(_SponsorCheck_SelfVer->'%(SponsorLandingUrl)')</_SponsorCheck_LandingUrlFromVer>
      <_SponsorCheck_CheckTransitiveFromRef>@(_SponsorCheck_Self->'%(CheckTransitiveReferences)')</_SponsorCheck_CheckTransitiveFromRef>
      <_SponsorCheck_CheckTransitiveFromVer>@(_SponsorCheck_SelfVer->'%(CheckTransitiveReferences)')</_SponsorCheck_CheckTransitiveFromVer>

      <!-- CheckTransitiveReferences="true" ships the generated verifier (and its sidecars) under
           buildTransitive/ instead of build/. NuGet imports build/<id>.targets only for *direct*
           PackageReferences, but buildTransitive/<id>.targets for direct *and* transitive ones — so
           the folder choice is the direct-vs-transitive toggle. Default (unset/false) keeps build/:
           direct references only, preserving the prior behaviour. Prefer the value off the
           PackageReference, falling back to PackageVersion (CPM), mirroring the merges above. -->
      <_SponsorCheck_CheckTransitive>$(_SponsorCheck_CheckTransitiveFromRef)</_SponsorCheck_CheckTransitive>
      <_SponsorCheck_CheckTransitive Condition="'$(_SponsorCheck_CheckTransitive)' == ''">$(_SponsorCheck_CheckTransitiveFromVer)</_SponsorCheck_CheckTransitive>
      <_SponsorCheck_BuildFolder>build</_SponsorCheck_BuildFolder>
      <_SponsorCheck_BuildFolder Condition="'$(_SponsorCheck_CheckTransitive)' == 'true'">buildTransitive</_SponsorCheck_BuildFolder>
    </PropertyGroup>

    <!-- Coexist with packages that ship their own <PackageId>.targets. NuGet auto-imports exactly one
         file named <PackageId>.targets, and SponsorCheck claims that slot for the generated verifier.
         If the author already packs their own <PackageId>.targets into the folder we are about to write
         to, packing the verifier there too collides — NU5118, or (when warnings aren't errors) a
         silently dropped verifier. Detect the author's item now, while @(None) still holds only
         author-authored items (our own <None> additions happen further below), so we can relocate it to
         a sidecar and have the bundler <Import> that sidecar from the verifier. Both forward and back
         slashes are matched since either is valid in a PackagePath. -->
    <!-- %5C is the MSBuild escape for a literal backslash. A raw '\' between two $(..) refs (e.g.
         '$(BuildFolder)\$(PackageId).targets') is normalized to '/' by MSBuild's expression evaluator
         on Linux, collapsing the back- and forward-slash variants to the same value and breaking the
         comparison against the author's '\'-bearing PackagePath metadata (item metadata is preserved
         verbatim, even on Linux). %5C is decoded to literal '\' on every platform and survives the
         normalization. Regression coverage: ThePackageOwnTargetsCpm fixture + OwnTargets_RelocatedToSidecar_Cpm test. -->
    <PropertyGroup>
      <_SponsorCheck_OwnTargetsPackagePath>$(_SponsorCheck_BuildFolder)%5C$(PackageId).targets</_SponsorCheck_OwnTargetsPackagePath>
      <_SponsorCheck_OwnTargetsPackagePathAlt>$(_SponsorCheck_BuildFolder)/$(PackageId).targets</_SponsorCheck_OwnTargetsPackagePathAlt>
      <_SponsorCheck_InnerTargetsFileName>$(PackageId).SponsorCheckInner.targets</_SponsorCheck_InnerTargetsFileName>
    </PropertyGroup>

    <ItemGroup>
      <_SponsorCheck_AuthorOwnTargets Include="@(None)"
          Condition="'%(None.Pack)' == 'true' and ('%(None.PackagePath)' == '$(_SponsorCheck_OwnTargetsPackagePath)' or '%(None.PackagePath)' == '$(_SponsorCheck_OwnTargetsPackagePathAlt)')" />
    </ItemGroup>

    <PropertyGroup>
      <_SponsorCheck_HasAuthorOwnTargets>false</_SponsorCheck_HasAuthorOwnTargets>
      <_SponsorCheck_HasAuthorOwnTargets Condition="'@(_SponsorCheck_AuthorOwnTargets)' != ''">true</_SponsorCheck_HasAuthorOwnTargets>
      <!-- Empty unless an author-owned targets was found, so the bundler emits no <Import> in the common case. -->
      <_SponsorCheck_InnerImportArg Condition="'$(_SponsorCheck_HasAuthorOwnTargets)' == 'true'">$(_SponsorCheck_InnerTargetsFileName)</_SponsorCheck_InnerImportArg>
    </PropertyGroup>

    <BundleSponsorListTask
        GitHubSponsorsAccountFromRef="$(_SponsorCheck_GitHubFromRef)"
        GitHubSponsorsAccountFromVer="$(_SponsorCheck_GitHubFromVer)"
        OpenCollectiveAccountFromRef="$(_SponsorCheck_OpenCollectiveFromRef)"
        OpenCollectiveAccountFromVer="$(_SponsorCheck_OpenCollectiveFromVer)"
        PolarAccountFromRef="$(_SponsorCheck_PolarFromRef)"
        PolarAccountFromVer="$(_SponsorCheck_PolarFromVer)"
        SponsorOwnerFromRef="$(_SponsorCheck_OwnerFromRef)"
        SponsorOwnerFromVer="$(_SponsorCheck_OwnerFromVer)"
        NoLicenseSpecifiedSeverityOverrideFromRef="$(_SponsorCheck_NoLicenseSpecifiedSevFromRef)"
        NoLicenseSpecifiedSeverityOverrideFromVer="$(_SponsorCheck_NoLicenseSpecifiedSevFromVer)"
        LicenseIgnoredSeverityOverrideFromRef="$(_SponsorCheck_LicenseIgnoredSevFromRef)"
        LicenseIgnoredSeverityOverrideFromVer="$(_SponsorCheck_LicenseIgnoredSevFromVer)"
        InvalidAccountSeverityOverrideFromRef="$(_SponsorCheck_InvalidAccountSevFromRef)"
        InvalidAccountSeverityOverrideFromVer="$(_SponsorCheck_InvalidAccountSevFromVer)"
        LicenseExpiredSeverityOverrideFromRef="$(_SponsorCheck_LicenseExpiredSevFromRef)"
        LicenseExpiredSeverityOverrideFromVer="$(_SponsorCheck_LicenseExpiredSevFromVer)"
        NoLicenseSpecifiedMessageOverrideFromRef="$(_SponsorCheck_NoLicenseSpecifiedMsgFromRef)"
        NoLicenseSpecifiedMessageOverrideFromVer="$(_SponsorCheck_NoLicenseSpecifiedMsgFromVer)"
        LicenseIgnoredMessageOverrideFromRef="$(_SponsorCheck_LicenseIgnoredMsgFromRef)"
        LicenseIgnoredMessageOverrideFromVer="$(_SponsorCheck_LicenseIgnoredMsgFromVer)"
        InvalidAccountMessageOverrideFromRef="$(_SponsorCheck_InvalidAccountMsgFromRef)"
        InvalidAccountMessageOverrideFromVer="$(_SponsorCheck_InvalidAccountMsgFromVer)"
        LicenseExpiredMessageOverrideFromRef="$(_SponsorCheck_LicenseExpiredMsgFromRef)"
        LicenseExpiredMessageOverrideFromVer="$(_SponsorCheck_LicenseExpiredMsgFromVer)"
        SponsorLandingUrlFromRef="$(_SponsorCheck_LandingUrlFromRef)"
        SponsorLandingUrlFromVer="$(_SponsorCheck_LandingUrlFromVer)"
        GitHubToken="$(GitHubToken)"
        OpenCollectiveToken="$(OpenCollectiveToken)"
        PolarToken="$(PolarToken)"
        UserSecretsId="$(UserSecretsId)"
        OverrideListPath="$(SponsorListOverride)"
        VerifierTargetsTemplatePath="$(_SponsorCheck_VerifierTemplate)"
        VerifierOwnerTargetsTemplatePath="$(_SponsorCheck_VerifierOwnerTemplate)"
        InnerTargetsImportFileName="$(_SponsorCheck_InnerImportArg)"
        ThePackageId="$(PackageId)"
        OutputHashListPath="$(_SponsorCheck_HashListPath)"
        OutputVerifierTargetsPath="$(_SponsorCheck_GeneratedTargetsPath)"
        OutputPackDatePath="$(_SponsorCheck_PackDatePath)"
        OutputAuthorAccountsPath="$(_SponsorCheck_AuthorAccountsPath)"
        OutputSeverityOverridesPath="$(_SponsorCheck_SeverityOverridesPath)"
        OutputMessageOverridesPath="$(_SponsorCheck_MessageOverridesPath)"
        OutputLandingUrlPath="$(_SponsorCheck_LandingUrlPath)"
        OverridePackDate="$(SponsorCheck_PackDateOverride)" />

    <!-- Move the author's own <PackageId>.targets aside to the sidecar the verifier imports, freeing
         the <PackageId>.targets slot for the verifier <None> added below. MatchOnMetadata="PackagePath"
         removes only the colliding item: an author who also ships the file to build\ (for direct refs,
         when we pack into buildTransitive\) keeps that copy untouched — only the one in our pack folder
         is relocated. The sidecar import in the verifier loads the author's logic for every consumer. -->
    <ItemGroup Condition="'$(_SponsorCheck_HasAuthorOwnTargets)' == 'true'">
      <None Remove="@(_SponsorCheck_AuthorOwnTargets)" MatchOnMetadata="PackagePath" />
      <None Include="@(_SponsorCheck_AuthorOwnTargets)"
            Pack="true"
            PackagePath="$(_SponsorCheck_BuildFolder)\$(_SponsorCheck_InnerTargetsFileName)"
            Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <None Include="$(_SponsorCheck_HashListPath)"
            Pack="true"
            PackagePath="$(_SponsorCheck_BuildFolder)\SponsorCheck.SponsorHashes.txt"
            Visible="false" />
      <None Include="$(_SponsorCheck_PackDatePath)"
            Pack="true"
            PackagePath="$(_SponsorCheck_BuildFolder)\SponsorCheck.PackDate.txt"
            Visible="false" />
      <None Include="$(_SponsorCheck_AuthorAccountsPath)"
            Pack="true"
            PackagePath="$(_SponsorCheck_BuildFolder)\SponsorCheck.AuthorAccounts.txt"
            Visible="false" />
      <None Include="$(_SponsorCheck_SeverityOverridesPath)"
            Pack="true"
            PackagePath="$(_SponsorCheck_BuildFolder)\SponsorCheck.SeverityOverrides.txt"
            Visible="false" />
      <None Include="$(_SponsorCheck_MessageOverridesPath)"
            Pack="true"
            PackagePath="$(_SponsorCheck_BuildFolder)\SponsorCheck.MessageOverrides.json"
            Visible="false" />
      <None Include="$(_SponsorCheck_LandingUrlPath)"
            Pack="true"
            PackagePath="$(_SponsorCheck_BuildFolder)\SponsorCheck.LandingUrl.txt"
            Visible="false" />
      <None Include="$(_SponsorCheck_GeneratedTargetsPath)"
            Pack="true"
            PackagePath="$(_SponsorCheck_BuildFolder)\$(PackageId).targets"
            Visible="false" />
      <!-- Forward slash in PackagePath — see SponsorCheck.csproj for the rationale (Linux MSBuild
           + NuGet pack produces 'tasks/netstandard2.0//<dll>' double-slashes with '\' here). -->
      <None Include="$(_SponsorCheck_TasksDir)netstandard2.0\*.dll"
            Pack="true"
            PackagePath="tasks/netstandard2.0/"
            Visible="false" />
      <None Include="$(_SponsorCheck_TasksDir)net472\*.dll"
            Pack="true"
            PackagePath="tasks/net472/"
            Visible="false" />
    </ItemGroup>
  </Target>
</Project>
