<Project>
  <PropertyGroup>
    <_SponsorCheck_ThePackageId>__SC_PACKAGE_ID_RAW__</_SponsorCheck_ThePackageId>
    <_SponsorCheck_TasksDir>$(MSBuildThisFileDirectory)..\tasks\</_SponsorCheck_TasksDir>
    <_SponsorCheck_TasksAssembly Condition="'$(MSBuildRuntimeType)' == 'Core'">$(_SponsorCheck_TasksDir)netstandard2.0\SponsorCheck.dll</_SponsorCheck_TasksAssembly>
    <_SponsorCheck_TasksAssembly Condition="'$(MSBuildRuntimeType)' != 'Core'">$(_SponsorCheck_TasksDir)net472\SponsorCheck.dll</_SponsorCheck_TasksAssembly>
    <_SponsorCheck_HashListPath>$(MSBuildThisFileDirectory)SponsorCheck.SponsorHashes.txt</_SponsorCheck_HashListPath>
    <_SponsorCheck_PackDatePath>$(MSBuildThisFileDirectory)SponsorCheck.PackDate.txt</_SponsorCheck_PackDatePath>
    <_SponsorCheck_AuthorAccountsPath>$(MSBuildThisFileDirectory)SponsorCheck.AuthorAccounts.txt</_SponsorCheck_AuthorAccountsPath>
    <_SponsorCheck_SeverityOverridesPath>$(MSBuildThisFileDirectory)SponsorCheck.SeverityOverrides.txt</_SponsorCheck_SeverityOverridesPath>
    <_SponsorCheck_MessageOverridesPath>$(MSBuildThisFileDirectory)SponsorCheck.MessageOverrides.json</_SponsorCheck_MessageOverridesPath>
  </PropertyGroup>

  <UsingTask TaskName="VerifySponsorshipTask"
             AssemblyFile="$(_SponsorCheck_TasksAssembly)" />

  <Target Name="_SponsorCheck_Verify___SC_PACKAGE_ID__"
          BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_SponsorCheck___SC_PACKAGE_ID___Ref Include="@(PackageReference)" Condition="'%(Identity)' == '$(_SponsorCheck_ThePackageId)'" />
      <_SponsorCheck___SC_PACKAGE_ID___Ver Include="@(PackageVersion)"   Condition="'%(Identity)' == '$(_SponsorCheck_ThePackageId)'" />
    </ItemGroup>

    <!-- Flatten item-metadata into properties first so MSBuild doesn't task-batch. See SponsorCheck.targets for the full explanation. -->
    <PropertyGroup>
      <_SponsorCheck___SC_PACKAGE_ID___IgnoredFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(SponsorshipLicenseIgnored)')</_SponsorCheck___SC_PACKAGE_ID___IgnoredFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___IgnoredFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(SponsorshipLicenseIgnored)')</_SponsorCheck___SC_PACKAGE_ID___IgnoredFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(SponsorshipLicensedUntil)')</_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(SponsorshipLicensedUntil)')</_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(SponsorshipStart)')</_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(SponsorshipStart)')</_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___GitHubFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(GitHubSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___GitHubFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___GitHubFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(GitHubSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___GitHubFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(OpenCollectiveSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(OpenCollectiveSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___PolarFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(PolarSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___PolarFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___PolarFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(PolarSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___PolarFromVer>
    </PropertyGroup>

    <VerifySponsorshipTask
        ThePackageId="$(_SponsorCheck_ThePackageId)"
        SponsorHashListPath="$(_SponsorCheck_HashListPath)"
        PackDatePath="$(_SponsorCheck_PackDatePath)"
        AuthorAccountsPath="$(_SponsorCheck_AuthorAccountsPath)"
        SeverityOverridesPath="$(_SponsorCheck_SeverityOverridesPath)"
        MessageOverridesPath="$(_SponsorCheck_MessageOverridesPath)"
        IgnoredFromRef="$(_SponsorCheck___SC_PACKAGE_ID___IgnoredFromRef)"
        IgnoredFromVer="$(_SponsorCheck___SC_PACKAGE_ID___IgnoredFromVer)"
        LicensedUntilFromRef="$(_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromRef)"
        LicensedUntilFromVer="$(_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromVer)"
        SponsorshipStartFromRef="$(_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromRef)"
        SponsorshipStartFromVer="$(_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromVer)"
        GitHubFromRef="$(_SponsorCheck___SC_PACKAGE_ID___GitHubFromRef)"
        GitHubFromVer="$(_SponsorCheck___SC_PACKAGE_ID___GitHubFromVer)"
        OpenCollectiveFromRef="$(_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromRef)"
        OpenCollectiveFromVer="$(_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromVer)"
        PolarFromRef="$(_SponsorCheck___SC_PACKAGE_ID___PolarFromRef)"
        PolarFromVer="$(_SponsorCheck___SC_PACKAGE_ID___PolarFromVer)" />
  </Target>
</Project>
