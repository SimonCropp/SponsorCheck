<Project>
__SC_INNER_IMPORT__
  <!-- Every property here is scoped to the package it verifies, because this file is imported once per
       referenced package and MSBuild properties are global. An unscoped name is written by each import in
       turn and the last one wins for the whole project, so two of these files would share one set
       of paths: each verifier would read another package's sponsor list, exemptions and task
       assembly. The task-name collision below is the same problem — this is the rest of it.

       The clobbered TasksDir also reached the *authoring* side. A package whose author references
       another SponsorCheck package packs `$(TasksDir)netstandard2.0\*.dll` into its own nupkg, so
       it shipped whichever SponsorCheck the other package bundled — a stale task in a package
       whose restore was correct, failing only for its consumers. -->
  <PropertyGroup>
    <_SponsorCheck___SC_PACKAGE_ID___ThePackageId>__SC_PACKAGE_ID_RAW__</_SponsorCheck___SC_PACKAGE_ID___ThePackageId>
    <_SponsorCheck___SC_PACKAGE_ID___TasksDir>$(MSBuildThisFileDirectory)..\tasks\</_SponsorCheck___SC_PACKAGE_ID___TasksDir>
    <_SponsorCheck___SC_PACKAGE_ID___TasksAssembly Condition="'$(MSBuildRuntimeType)' == 'Core'">$(_SponsorCheck___SC_PACKAGE_ID___TasksDir)netstandard2.0\SponsorCheck.dll</_SponsorCheck___SC_PACKAGE_ID___TasksAssembly>
    <_SponsorCheck___SC_PACKAGE_ID___TasksAssembly Condition="'$(MSBuildRuntimeType)' != 'Core'">$(_SponsorCheck___SC_PACKAGE_ID___TasksDir)net472\SponsorCheck.dll</_SponsorCheck___SC_PACKAGE_ID___TasksAssembly>
    <_SponsorCheck___SC_PACKAGE_ID___HashListPath>$(MSBuildThisFileDirectory)SponsorCheck.SponsorHashes.txt</_SponsorCheck___SC_PACKAGE_ID___HashListPath>
    <_SponsorCheck___SC_PACKAGE_ID___PackDatePath>$(MSBuildThisFileDirectory)SponsorCheck.PackDate.txt</_SponsorCheck___SC_PACKAGE_ID___PackDatePath>
    <_SponsorCheck___SC_PACKAGE_ID___AuthorAccountsPath>$(MSBuildThisFileDirectory)SponsorCheck.AuthorAccounts.txt</_SponsorCheck___SC_PACKAGE_ID___AuthorAccountsPath>
    <_SponsorCheck___SC_PACKAGE_ID___SeverityOverridesPath>$(MSBuildThisFileDirectory)SponsorCheck.SeverityOverrides.txt</_SponsorCheck___SC_PACKAGE_ID___SeverityOverridesPath>
    <_SponsorCheck___SC_PACKAGE_ID___MessageOverridesPath>$(MSBuildThisFileDirectory)SponsorCheck.MessageOverrides.json</_SponsorCheck___SC_PACKAGE_ID___MessageOverridesPath>
    <_SponsorCheck___SC_PACKAGE_ID___LandingUrlPath>$(MSBuildThisFileDirectory)SponsorCheck.LandingUrl.txt</_SponsorCheck___SC_PACKAGE_ID___LandingUrlPath>
    <_SponsorCheck___SC_PACKAGE_ID___ExemptionsPath>$(MSBuildThisFileDirectory)SponsorCheck.Exemptions.json</_SponsorCheck___SC_PACKAGE_ID___ExemptionsPath>
  </PropertyGroup>

  <!-- __SC_TASK_NAME__ renders to the version-scoped task type (VerifySponsorshipTask_<version>).
       MSBuild's task registry is keyed by task *name*, and the first UsingTask to claim a name wins
       for the whole project — the assembly identity is not part of the key. Two packages bundling
       different SponsorCheck versions therefore used to share one registration, and whichever one
       registered first supplied the task for both: MSB4064 as soon as the newer verifier passed a
       parameter the older task didn't declare. A version-scoped name gives each SponsorCheck release
       its own registration, so every verifier binds to the copy it was generated against. -->
  <UsingTask TaskName="__SC_TASK_NAME__"
             AssemblyFile="$(_SponsorCheck___SC_PACKAGE_ID___TasksAssembly)" />

  <!-- Project-reference coverage responders — see ConsumerVerifierOwner.targets for the rationale.
       For per-package mode, transitive consumers can't supply the required <PackageReference>
       metadata, so without this they'd always fail SC001/SC002 under CheckTransitiveReferences. -->
  <Target Name="_SponsorCheck_CoversDeep___SC_PACKAGE_ID__"
          Returns="@(_SponsorCheck_Covered___SC_PACKAGE_ID__)">
    <ItemGroup>
      <_SponsorCheck_Covered___SC_PACKAGE_ID__
          Include="$(_SponsorCheck___SC_PACKAGE_ID___ThePackageId)"
          Condition="@(PackageReference->AnyHaveMetadataValue('Identity', '$(_SponsorCheck___SC_PACKAGE_ID___ThePackageId)'))" />
    </ItemGroup>
    <MSBuild Projects="@(ProjectReference)"
             Targets="_SponsorCheck_CoversShallow___SC_PACKAGE_ID__"
             SkipNonexistentTargets="true"
             Condition="'@(_SponsorCheck_Covered___SC_PACKAGE_ID__)' == '' and '@(ProjectReference)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SponsorCheck_Covered___SC_PACKAGE_ID__" />
    </MSBuild>
  </Target>

  <Target Name="_SponsorCheck_CoversShallow___SC_PACKAGE_ID__"
          Returns="@(_SponsorCheck_CoveredShallow___SC_PACKAGE_ID__)">
    <ItemGroup>
      <_SponsorCheck_CoveredShallow___SC_PACKAGE_ID__
          Include="$(_SponsorCheck___SC_PACKAGE_ID___ThePackageId)"
          Condition="@(PackageReference->AnyHaveMetadataValue('Identity', '$(_SponsorCheck___SC_PACKAGE_ID___ThePackageId)'))" />
    </ItemGroup>
  </Target>

  <Target Name="_SponsorCheck_Verify___SC_PACKAGE_ID__"
          BeforeTargets="BeforeBuild">
    <MSBuild Projects="@(ProjectReference)"
             Targets="_SponsorCheck_CoversDeep___SC_PACKAGE_ID__"
             SkipNonexistentTargets="true"
             Condition="'@(ProjectReference)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SponsorCheck_RefCovers___SC_PACKAGE_ID__" />
    </MSBuild>

    <ItemGroup>
      <_SponsorCheck___SC_PACKAGE_ID___Ref Include="@(PackageReference)" Condition="'%(Identity)' == '$(_SponsorCheck___SC_PACKAGE_ID___ThePackageId)'" />
      <_SponsorCheck___SC_PACKAGE_ID___Ver Include="@(PackageVersion)"   Condition="'%(Identity)' == '$(_SponsorCheck___SC_PACKAGE_ID___ThePackageId)'" />
    </ItemGroup>

    <!-- Flatten item-metadata into properties first so MSBuild doesn't task-batch. See SponsorCheck.targets for the full explanation. -->
    <PropertyGroup>
      <_SponsorCheck___SC_PACKAGE_ID___VersionFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(Version)')</_SponsorCheck___SC_PACKAGE_ID___VersionFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___VersionFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(Version)')</_SponsorCheck___SC_PACKAGE_ID___VersionFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___IgnoredFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(SponsorshipLicenseIgnored)')</_SponsorCheck___SC_PACKAGE_ID___IgnoredFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___IgnoredFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(SponsorshipLicenseIgnored)')</_SponsorCheck___SC_PACKAGE_ID___IgnoredFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(SponsorshipLicensedUntil)')</_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(SponsorshipLicensedUntil)')</_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___ExemptionFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(SponsorshipExemption)')</_SponsorCheck___SC_PACKAGE_ID___ExemptionFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___ExemptionFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(SponsorshipExemption)')</_SponsorCheck___SC_PACKAGE_ID___ExemptionFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___ExemptionUntilFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(SponsorshipExemptionUntil)')</_SponsorCheck___SC_PACKAGE_ID___ExemptionUntilFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___ExemptionUntilFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(SponsorshipExemptionUntil)')</_SponsorCheck___SC_PACKAGE_ID___ExemptionUntilFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(SponsorshipStart)')</_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(SponsorshipStart)')</_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___GitHubFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(GitHubSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___GitHubFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___GitHubFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(GitHubSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___GitHubFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(OpenCollectiveSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(OpenCollectiveSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromVer>
      <_SponsorCheck___SC_PACKAGE_ID___PolarFromRef>@(_SponsorCheck___SC_PACKAGE_ID___Ref->'%(PolarSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___PolarFromRef>
      <_SponsorCheck___SC_PACKAGE_ID___PolarFromVer>@(_SponsorCheck___SC_PACKAGE_ID___Ver->'%(PolarSponsorAccount)')</_SponsorCheck___SC_PACKAGE_ID___PolarFromVer>
    </PropertyGroup>

    <__SC_TASK_NAME__
        Condition="'@(_SponsorCheck_RefCovers___SC_PACKAGE_ID__)' == ''"
        ThePackageId="$(_SponsorCheck___SC_PACKAGE_ID___ThePackageId)"
        SponsorHashListPath="$(_SponsorCheck___SC_PACKAGE_ID___HashListPath)"
        PackDatePath="$(_SponsorCheck___SC_PACKAGE_ID___PackDatePath)"
        AuthorAccountsPath="$(_SponsorCheck___SC_PACKAGE_ID___AuthorAccountsPath)"
        SeverityOverridesPath="$(_SponsorCheck___SC_PACKAGE_ID___SeverityOverridesPath)"
        MessageOverridesPath="$(_SponsorCheck___SC_PACKAGE_ID___MessageOverridesPath)"
        LandingUrlPath="$(_SponsorCheck___SC_PACKAGE_ID___LandingUrlPath)"
        ExemptionsPath="$(_SponsorCheck___SC_PACKAGE_ID___ExemptionsPath)"
        IsCpm="$(ManagePackageVersionsCentrally)"
        ConsumerProjectPath="$(MSBuildProjectFullPath)"
        DirectoryPackagesPropsPath="$(DirectoryPackagesPropsPath)"
        PackageVersionFromRef="$(_SponsorCheck___SC_PACKAGE_ID___VersionFromRef)"
        PackageVersionFromVer="$(_SponsorCheck___SC_PACKAGE_ID___VersionFromVer)"
        IgnoredFromRef="$(_SponsorCheck___SC_PACKAGE_ID___IgnoredFromRef)"
        IgnoredFromVer="$(_SponsorCheck___SC_PACKAGE_ID___IgnoredFromVer)"
        LicensedUntilFromRef="$(_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromRef)"
        LicensedUntilFromVer="$(_SponsorCheck___SC_PACKAGE_ID___LicensedUntilFromVer)"
        SponsorshipExemptionFromRef="$(_SponsorCheck___SC_PACKAGE_ID___ExemptionFromRef)"
        SponsorshipExemptionFromVer="$(_SponsorCheck___SC_PACKAGE_ID___ExemptionFromVer)"
        SponsorshipExemptionUntilFromRef="$(_SponsorCheck___SC_PACKAGE_ID___ExemptionUntilFromRef)"
        SponsorshipExemptionUntilFromVer="$(_SponsorCheck___SC_PACKAGE_ID___ExemptionUntilFromVer)"
        SponsorshipStartFromRef="$(_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromRef)"
        SponsorshipStartFromVer="$(_SponsorCheck___SC_PACKAGE_ID___SponsorshipStartFromVer)"
        GitHubFromRef="$(_SponsorCheck___SC_PACKAGE_ID___GitHubFromRef)"
        GitHubFromVer="$(_SponsorCheck___SC_PACKAGE_ID___GitHubFromVer)"
        OpenCollectiveFromRef="$(_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromRef)"
        OpenCollectiveFromVer="$(_SponsorCheck___SC_PACKAGE_ID___OpenCollectiveFromVer)"
        PolarFromRef="$(_SponsorCheck___SC_PACKAGE_ID___PolarFromRef)"
        PolarFromVer="$(_SponsorCheck___SC_PACKAGE_ID___PolarFromVer)" />
  </Target>
</Project>
