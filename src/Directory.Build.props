<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <NoWarn>CS1591;NU1608;NU1109;NU1901;PolyfillTargetsForNuget</NoWarn>
    <Version>0.20.0</Version>
    <LangVersion>preview</LangVersion>
    <!-- Do NOT pin AssemblyVersion. SponsorCheck.dll is an MSBuild task assembly shipped inside many
         packages (Morph, Parchment, OpenXmlHtml, Excelsior, ...), so a fixed AssemblyVersion would give
         every release one assembly identity and let MSBuild's assembly cache serve whichever copy loaded
         first. Defaulting it to Version keeps each release distinct.

         This alone does NOT prevent MSB4064 ("parameter X not supported by VerifySponsorshipTask") —
         MSBuild's *task registry* is keyed by task name, so the first UsingTask to claim a name wins
         before assembly identity is ever consulted. The version-scoped task type generated by
         _SponsorCheck_GenerateVersionedTaskName in SponsorCheck.csproj is what fixes that; $(Version)
         feeds its name, which is the other reason this must stay per-release. -->
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <Description>Enforce the Licensing/Sponsorship Fee at build time via pluggable sponsorship platforms (GitHub Sponsors, Open Collective, Polar).</Description>
    <Authors>Simon Cropp</Authors>
    <Copyright>Copyright Simon Cropp</Copyright>
    <PackageProjectUrl>https://github.com/SimonCropp/SponsorCheck</PackageProjectUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\nugets</PackageOutputPath>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
</Project>
