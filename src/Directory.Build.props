<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <NoWarn>CS1591;NU1608;NU1109;NU1901;PolyfillTargetsForNuget</NoWarn>
    <Version>0.1.8</Version>
    <LangVersion>preview</LangVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <Description>Enforce the Open Source Maintenance Fee at build time via pluggable sponsorship platforms (GitHub Sponsors, Open Collective, Polar).</Description>
    <Authors>Simon Cropp</Authors>
    <Copyright>Copyright Simon Cropp</Copyright>
    <PackageProjectUrl>https://github.com/SimonCropp/SponsorCheck</PackageProjectUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\nugets</PackageOutputPath>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
</Project>
