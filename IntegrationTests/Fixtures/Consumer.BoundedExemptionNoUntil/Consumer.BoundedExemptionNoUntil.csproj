<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Evaluation is time-bounded by the publisher, so claiming it without
         SponsorshipExemptionUntil must fail with SC038. -->
    <PackageReference
      Include="ThePackageWithExemptions"
      Version="1.0.0"
      SponsorshipExemption="Evaluation" />
  </ItemGroup>
</Project>
