<Project>
  <!-- Owner mode: sponsorship for owner 'acme' configured once via the owner-scoped property,
       here in Directory.Build.props. Covers every package from the same owner referenced under
       this directory. A different owner would need its own <{owner}_GitHubSponsorAccount>. -->
  <PropertyGroup>
    <acme_GitHubSponsorAccount>alice</acme_GitHubSponsorAccount>
  </PropertyGroup>
</Project>
