<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SponsorCheck" Version="$(SponsorCheckVersion)"
                      PrivateAssets="all"
                      GitHubSponsorsAccount="acmecorp"
                      OpenCollectiveAccount="acme-org"
                      PolarAccount="acme"
                      NoLicenseSpecifiedSeverityOverride="warning"
                      NoLicenseSpecifiedMessageOverride="Please sponsor ThePackageOverridden before using."
                      LicenseIgnoredSeverityOverride="error"
                      LicenseIgnoredMessageOverride="You agreed not to free-ride this library." />
  </ItemGroup>
</Project>
