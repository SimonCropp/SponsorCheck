<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- GitHub Sponsors requires a token. When packed without SponsorListOverride and with no
         GitHubToken supplied, the fetch throws MissingCredentialException -> SC102. -->
    <PackageReference Include="SponsorCheck" Version="$(SponsorCheckVersion)"
                      PrivateAssets="all"
                      GitHubSponsorsAccount="acmecorp" />
  </ItemGroup>
</Project>
