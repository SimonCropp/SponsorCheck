<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- ThePackageTransitive is pulled in only transitively, via MiddlePackageTransitive. Because the
         author set CheckTransitiveReferences, the verifier runs here too — and with no sponsor account
         declared, the build fails with SC001. -->
    <PackageReference Include="MiddlePackageTransitive" Version="1.0.0" />
  </ItemGroup>
</Project>
